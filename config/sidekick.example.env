# Sidekick Configuration Example

# Ollama Endpoint
SIDEKICK_OLLAMA_BASE_URL="http://localhost:11434"

# Local LLM Model (Default: qwen2.5:14b with GPU layer restriction)
SIDEKICK_MODEL="qwen2.5:14b"

# Maximum self-fix retry iterations for lint/test
SIDEKICK_MAX_RETRIES=2

# Timeout in seconds for LLM generation
SIDEKICK_TIMEOUT_SECONDS=180

# Repository Exploration Limits
SIDEKICK_MAX_FILES=40
SIDEKICK_MAX_FILE_BYTES=50000
SIDEKICK_MAX_CONTEXT_BYTES=300000

# Working paths (defaults to target repository root)
SIDEKICK_RULES_PATH=".ai/RULES.md"
SIDEKICK_TASK_PATH=".ai/TASK.md"
SIDEKICK_RESULT_PATH=".ai/RESULT.md"
SIDEKICK_DECISIONS_PATH=".ai/DECISIONS.md"
SIDEKICK_SYSTEM_PROMPT_PATH="prompts/sidekick-system.md"

# Phase 2 Git Automation Settings
SIDEKICK_AUTO_GIT=false
SIDEKICK_AUTO_BRANCH=true
SIDEKICK_AUTO_COMMIT=true
SIDEKICK_AUTO_PUSH=true
SIDEKICK_CREATE_PR=false
SIDEKICK_WATCH_INTERVAL=3
SIDEKICK_REQUIRE_CLEAN_GIT=true
SIDEKICK_COMMIT_TASK_FILE=true
SIDEKICK_COMMIT_RESULT_FILE=true
