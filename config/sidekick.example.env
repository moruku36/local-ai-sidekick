# Sidekick Configuration Example

# Ollama Endpoint
SIDEKICK_OLLAMA_BASE_URL="http://localhost:11434"

# Local LLM Model (available on this machine: qwen2.5-coder:7b, qwen2.5:14b, llama3.1:8b, gemma2:9b, etc.)
SIDEKICK_MODEL="qwen2.5-coder:7b"

# Maximum self-fix retry iterations for lint/test
SIDEKICK_MAX_RETRIES=2

# Timeout in seconds for LLM generation
SIDEKICK_TIMEOUT_SECONDS=180

# Working paths (defaults to target repository root)
SIDEKICK_RULES_PATH=".ai/RULES.md"
SIDEKICK_TASK_PATH=".ai/TASK.md"
SIDEKICK_RESULT_PATH=".ai/RESULT.md"
SIDEKICK_DECISIONS_PATH=".ai/DECISIONS.md"
SIDEKICK_SYSTEM_PROMPT_PATH="prompts/sidekick-system.md"
